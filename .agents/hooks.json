{
  "workspace-file-hygiene": {
    "PreToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/pre-tool-guard.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "auto-verify-before-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/stop-verify-gate.ps1",
        "timeout": 15
      }
    ]
  }
}
