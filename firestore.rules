rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL HARDENED PRIMITIVES
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 5;
    }

    function emailToDocId(email) {
      return email.lower().replace('@', '_at_').replace('\\.', '_dot_').replace('[^a-z0-9_\\-]', '_');
    }

    function isPrimaryAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'weentamalak@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/admins/$(emailToDocId(request.auth.token.email)))
      );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidTier(tier) {
      return tier is string && tier in ['Silver', 'Gold', 'VIP', 'Lounge'];
    }

    // =========================================================================
    // VALIDATION BLUEPRINTS (Anti-Update-Gap)
    // =========================================================================
    function isValidConcert(data, docId) {
      return data.keys().hasAll([
          'id', 'title', 'artist', 'venue', 'isoDate', 'isoTime',
          'date', 'time', 'doors', 'genre', 'priceEgp', 'tierPrices',
          'totalSeats', 'seatsLeft', 'description', 'posterUrl',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'artist', 'venue', 'isoDate', 'isoTime',
          'date', 'time', 'doors', 'genre', 'priceEgp', 'tierPrices',
          'totalSeats', 'seatsLeft', 'description', 'posterUrl',
          'createdAt', 'updatedAt'
        ])
        && data.id == docId
        && isValidId(data.id)
        && data.id.size() >= 2 && data.id.size() <= 64
        && isValidString(data.title, 2, 120)
        && isValidString(data.artist, 2, 120)
        && isValidString(data.venue, 2, 140)
        && isValidString(data.isoDate, 10, 10) && data.isoDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && isValidString(data.isoTime, 5, 5) && data.isoTime.matches('^\\d{2}:\\d{2}$')
        && isValidString(data.date, 4, 40)
        && isValidString(data.time, 4, 20)
        && isValidString(data.doors, 4, 20)
        && isValidString(data.genre, 2, 60)
        && (data.priceEgp is int || data.priceEgp is float) && data.priceEgp >= 0 && data.priceEgp <= 100000
        && data.tierPrices is map
        && data.tierPrices.keys().hasAll(['Silver', 'Gold', 'VIP', 'Lounge'])
        && data.tierPrices.keys().hasOnly(['Silver', 'Gold', 'VIP', 'Lounge'])
        && (data.tierPrices.Silver is int || data.tierPrices.Silver is float) && data.tierPrices.Silver >= 0 && data.tierPrices.Silver <= 100000
        && (data.tierPrices.Gold is int || data.tierPrices.Gold is float) && data.tierPrices.Gold >= 0 && data.tierPrices.Gold <= 100000
        && (data.tierPrices.VIP is int || data.tierPrices.VIP is float) && data.tierPrices.VIP >= 0 && data.tierPrices.VIP <= 100000
        && (data.tierPrices.Lounge is int || data.tierPrices.Lounge is float) && data.tierPrices.Lounge >= 0 && data.tierPrices.Lounge <= 100000
        && data.totalSeats is int && data.totalSeats >= 1 && data.totalSeats <= 50000
        && data.seatsLeft is int && data.seatsLeft >= 0 && data.seatsLeft <= data.totalSeats
        && isValidString(data.description, 4, 800)
        && isValidString(data.posterUrl, 0, 400000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data, docId) {
      return data.keys().hasAll([
          'bookingCode', 'userId', 'concertId', 'concertTitle', 'concertDate',
          'concertTime', 'concertVenue', 'tier', 'quantity', 'unitPrice',
          'promoCode', 'discountEgp', 'totalEgp', 'paymentMethod', 'transferRef',
          'paymentStatus', 'checkedIn', 'checkedInAt', 'approvedBy',
          'approvalMethod', 'customerName', 'customerMobile', 'customerEmail',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingCode', 'userId', 'concertId', 'concertTitle', 'concertDate',
          'concertTime', 'concertVenue', 'tier', 'quantity', 'unitPrice',
          'promoCode', 'discountEgp', 'totalEgp', 'paymentMethod', 'transferRef',
          'paymentStatus', 'checkedIn', 'checkedInAt', 'approvedBy',
          'approvalMethod', 'customerName', 'customerMobile', 'customerEmail',
          'createdAt', 'updatedAt'
        ])
        && data.bookingCode == docId
        && isValidId(data.bookingCode)
        && data.bookingCode.size() >= 5 && data.bookingCode.size() <= 32
        && isValidId(data.userId)
        && isValidId(data.concertId) && data.concertId.size() >= 2 && data.concertId.size() <= 64
        && isValidString(data.concertTitle, 2, 120)
        && isValidString(data.concertDate, 4, 40)
        && isValidString(data.concertTime, 4, 20)
        && isValidString(data.concertVenue, 2, 140)
        && isValidTier(data.tier)
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 6
        && (data.unitPrice is int || data.unitPrice is float) && data.unitPrice >= 0 && data.unitPrice <= 100000
        && isValidString(data.promoCode, 0, 32)
        && (data.discountEgp is int || data.discountEgp is float) && data.discountEgp >= 0 && data.discountEgp <= 600000
        && (data.totalEgp is int || data.totalEgp is float) && data.totalEgp >= 0 && data.totalEgp <= 600000
        && data.paymentMethod is string && data.paymentMethod in ['InstaPay', 'Mobile Wallets']
        && isValidString(data.transferRef, 3, 80)
        && data.paymentStatus is string && data.paymentStatus in ['Pending', 'Paid']
        && data.checkedIn is bool
        && isValidString(data.checkedInAt, 0, 60)
        && isValidString(data.approvedBy, 0, 100)
        && isValidString(data.approvalMethod, 0, 40)
        && isValidString(data.customerName, 2, 100)
        && isValidString(data.customerMobile, 6, 30)
        && isValidString(data.customerEmail, 3, 120)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPromo(data, docId) {
      return data.keys().hasAll(['code', 'type', 'value', 'tiers', 'label', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'type', 'value', 'tiers', 'label', 'active', 'createdAt', 'updatedAt'])
        && data.code == docId
        && isValidString(data.code, 2, 32) && data.code.matches('^[A-Z0-9_\\-]+$')
        && data.type is string && data.type in ['percent', 'flat']
        && (data.value is int || data.value is float) && data.value > 0 && data.value <= 10000
        && (data.type != 'percent' || data.value <= 90)
        && data.tiers is list
        && data.tiers.size() <= 4
        && (data.tiers.size() == 0 || data.tiers.hasOnly(['Silver', 'Gold', 'VIP', 'Lounge']))
        && isValidString(data.label, 2, 120)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, docId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'mobile', 'city',
          'favoriteGenre', 'bio', 'favorites', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'mobile', 'city',
          'favoriteGenre', 'bio', 'favorites', 'createdAt', 'updatedAt'
        ])
        && data.uid == docId
        && isValidId(data.uid)
        && isValidString(data.displayName, 2, 100)
        && isValidString(data.email, 5, 120)
        && isValidString(data.mobile, 0, 30)
        && isValidString(data.city, 0, 60)
        && isValidString(data.favoriteGenre, 0, 60)
        && isValidString(data.bio, 0, 300)
        && data.favorites is list
        && data.favorites.size() <= 50
        && (data.favorites.size() == 0 || (data.favorites[0] is string && data.favorites[0].size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWaitlistEntry(data, docId) {
      return data.keys().hasAll(['id', 'userId', 'concertId', 'concertTitle', 'name', 'mobile', 'email', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'concertId', 'concertTitle', 'name', 'mobile', 'email', 'createdAt'])
        && data.id == docId
        && isValidId(data.id) && data.id.size() >= 2 && data.id.size() <= 64
        && isValidId(data.userId)
        && isValidId(data.concertId) && data.concertId.size() >= 2 && data.concertId.size() <= 64
        && isValidString(data.concertTitle, 2, 120)
        && isValidString(data.name, 2, 100)
        && isValidString(data.mobile, 6, 30)
        && isValidString(data.email, 0, 120)
        && data.createdAt is timestamp;
    }

    function isValidAdminMember(data, docId) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'addedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'email', 'role', 'addedBy', 'createdAt', 'updatedAt'])
        && data.id == docId
        && isValidId(data.id) && data.id.size() >= 2 && data.id.size() <= 128
        && isValidString(data.name, 2, 100)
        && isValidString(data.email, 3, 120)
        && data.role is string && data.role in ['Super Admin', 'Gate Staff']
        && isValidString(data.addedBy, 0, 120)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminSession(data, docId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'email', 'role', 'lastSeen', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'email', 'role', 'lastSeen', 'createdAt'])
        && data.id == docId
        && isValidId(data.id) && data.id.size() >= 2 && data.id.size() <= 64
        && isValidId(data.userId)
        && isValidString(data.name, 1, 100)
        && isValidString(data.email, 3, 120)
        && data.role is string && data.role in ['Super Admin', 'Gate Staff']
        && data.lastSeen is timestamp
        && data.createdAt is timestamp;
    }

    function isValidSiteSettings(data, docId) {
      return data.keys().hasAll(['id', 'seeded', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'seeded', 'createdAt', 'updatedAt'])
        && data.id == docId
        && isValidId(data.id) && data.id.size() >= 2 && data.id.size() <= 64
        && data.seeded is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // COLLECTIONS
    // =========================================================================

    // 1. Concerts: Publicly readable storefront catalog; Admin-only writes
    match /concerts/{concertId} {
      allow get: if isValidId(concertId);
      allow list: if true;
      allow create: if isVerified()
        && isValidId(concertId)
        && isValidConcert(incoming(), concertId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(concertId)
        && isValidConcert(incoming(), concertId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin();
      allow delete: if isVerified()
        && isValidId(concertId)
        && isAdmin();
    }

    // 2. Promos: Publicly readable discount codes; Admin-only writes
    match /promos/{promoId} {
      allow get: if isValidId(promoId);
      allow list: if true;
      allow create: if isVerified()
        && isValidId(promoId)
        && isValidPromo(incoming(), promoId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(promoId)
        && isValidPromo(incoming(), promoId)
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin();
      allow delete: if isVerified()
        && isValidId(promoId)
        && isAdmin();
    }

    // 3. Bookings: PII-isolated ticket orders & gate check-ins (verified accounts only)
    match /bookings/{bookingId} {
      allow get: if isVerified()
        && isValidId(bookingId)
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified()
        && isValidId(bookingId)
        && isValidBooking(incoming(), bookingId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/concerts/$(incoming().concertId))
        && (
          isAdmin() || (
            incoming().userId == request.auth.uid
            && incoming().paymentStatus == 'Pending'
            && incoming().checkedIn == false
            && incoming().checkedInAt == ''
            && incoming().approvedBy == ''
            && incoming().approvalMethod == ''
          )
        );
      allow update: if isVerified()
        && isValidId(bookingId)
        && isValidBooking(incoming(), bookingId)
        && incoming().bookingCode == existing().bookingCode
        && incoming().userId == existing().userId
        && incoming().concertId == existing().concertId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin();
      allow delete: if isVerified()
        && isValidId(bookingId)
        && (
          isAdmin() || (
            existing().userId == request.auth.uid
            && existing().paymentStatus == 'Pending'
            && existing().checkedIn == false
          )
        );
    }

    // 4. Users: Strictly private PII fan profiles (email-verified accounts only)
    match /users/{userId} {
      allow get: if isVerified()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().email.lower() == request.auth.token.email.lower()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            request.auth.uid == userId
            && incoming().email.lower() == request.auth.token.email.lower()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'email', 'mobile', 'city',
              'favoriteGenre', 'bio', 'favorites', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerified()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin());
    }

    // 5. Waitlist: Sold-out concert alerts (PII isolated, verified accounts only)
    match /waitlist/{entryId} {
      allow get: if isVerified()
        && isValidId(entryId)
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified()
        && isValidId(entryId)
        && isValidWaitlistEntry(incoming(), entryId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/concerts/$(incoming().concertId));
      allow update: if false;
      allow delete: if isVerified()
        && isValidId(entryId)
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // 6. Admins: Authorized staff directory
    match /admins/{adminId} {
      allow get: if isVerified()
        && isValidId(adminId)
        && (
          emailToDocId(request.auth.token.email) == adminId
          || isAdmin()
        );
      allow list: if isAdmin();
      allow create: if isVerified()
        && isValidId(adminId)
        && isValidAdminMember(incoming(), adminId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(adminId)
        && isValidAdminMember(incoming(), adminId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin();
      allow delete: if isVerified()
        && isValidId(adminId)
        && isAdmin();
    }

    // 7. Admin Sessions: Staff portal active session audit
    match /adminSessions/{sessionId} {
      allow get: if isVerified() && isValidId(sessionId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerified()
        && isValidId(sessionId)
        && isValidAdminSession(incoming(), sessionId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().lastSeen == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(sessionId)
        && isValidAdminSession(incoming(), sessionId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().lastSeen == request.time
        && isAdmin();
      allow delete: if isVerified() && isValidId(sessionId) && isAdmin();
    }

    // 8. Site Settings: Initialization state (prevents deleted items from reappearing)
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create: if isVerified()
        && isValidId(settingId)
        && isValidSiteSettings(incoming(), settingId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified()
        && isValidId(settingId)
        && isValidSiteSettings(incoming(), settingId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin();
      allow delete: if isVerified() && isValidId(settingId) && isAdmin();
    }
  }
}
